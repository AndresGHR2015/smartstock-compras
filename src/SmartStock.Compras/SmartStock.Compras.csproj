<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.12.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
    <EmbeddedResource Include="../../vendor/smartstock-infra/contracts/events/purchases.requests.v1/schema.json" LogicalName="Purchases.Requests.schema.json" />
    <EmbeddedResource Include="../../vendor/smartstock-infra/contracts/events/purchases.results.v1/schema.json" LogicalName="Purchases.Results.schema.json" />
  </ItemGroup>
</Project>
